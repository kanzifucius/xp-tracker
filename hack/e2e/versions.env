# Pinned versions for Crossplane e2e (CI workflow and make e2e).
# kind node image digest is from the kind v0.33.0 release notes.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.34.11@sha256:44e222ee2132dab25ff87301682f89eb82c7880ea3a1bf543bfe9708fd08d67d
KIND_CLUSTER_NAME=xp-tracker-e2e
KUBECTL_VERSION=v1.34.2
CROSSPLANE_CHART_REPO=https://charts.crossplane.io/stable
CROSSPLANE_CHART_NAME=crossplane
CROSSPLANE_CHART_VERSION=2.0.2
CROSSPLANE_NAMESPACE=crossplane-system
# provider-nop supplies Active MRDs + ClusterNopResource for XR-linked MR metrics.
# Same package pin as kindplane.yaml; chart defaultActivations=["*"] activates MRDs.
PROVIDER_NOP_PACKAGE=xpkg.upbound.io/crossplane-contrib/provider-nop:v0.5.0
PROVIDER_NOP_NAME=provider-nop
PROVIDER_NOP_MRD=clusternopresources.nop.crossplane.io
PROVIDER_NOP_CRD=clusternopresources.nop.crossplane.io
